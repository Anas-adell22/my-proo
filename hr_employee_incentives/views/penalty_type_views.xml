<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_penalty_type_list" model="ir.ui.view">
        <field name="name">penalty.type.list</field>
        <field name="model">penalty.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_penalty_type_form" model="ir.ui.view">
        <field name="name">penalty.type.form</field>
        <field name="model">penalty.type</field>
        <field name="arch" type="xml">
            <form string="نوع الجزاء">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,cancel"/>

                    <button name="action_approve"
                            string="اعتماد"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_cancel"
                            string="إلغاء"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'cancel'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly= "state == 'approved'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_penalty_type" model="ir.actions.act_window">
        <field name="name">أنواع الجزاءات</field>
        <field name="res_model">penalty.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_penalty_type"
              name="أنواع الجزاءات"
              action="action_penalty_type"
              parent="menu_configuration_category"
              sequence="10"/>
</odoo>
