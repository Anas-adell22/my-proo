<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_grievance_list" model="ir.ui.view">
        <field name="name">hr.grievance.list</field>
        <field name="model">hr.grievance</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'done'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="complained_department_id" optional="show"/>
                <field name="value"/>
                <field name="paid_amount" optional="show"/>
                <field name="remaining_amount" optional="show"/>
                <field name="decision" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="financial_state" optional="hide"/>
                <field name="hold_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_grievance_form" model="ir.ui.view">
        <field name="name">hr.grievance.form</field>
        <field name="model">hr.grievance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_in_progress" string="قيد التنفيذ" type="object" class="btn-primary"
                            invisible="state != 'request'"/>
                    <button name="action_accept" string="قبول" type="object" class="btn-primary"
                            invisible="state != 'in_progress' or decision == 'accepted'"/>
                    <button name="action_reject" string="رفض" type="object"
                            invisible="state not in ('request', 'in_progress') or decision == 'accepted'"
                            confirm="هل أنت متأكد من رفض التظلم؟"/>
                    <button name="action_reset" string="إرجاع لطلب" type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="request,in_progress,rejected,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_total" type="object" class="oe_stat_button" icon="fa-list-ul">
                            <field name="total_grievance_count" widget="statinfo" string="إجمالي التظلمات"/>
                        </button>
                        <button name="action_view_rejected" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="grievance_count" widget="statinfo" string="التظلمات المرفوضة"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button"
                                icon="fa-money" invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo" string="الدفعات"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="بيانات الموظف">
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                            <field name="employee_code"/>
                            <field name="job_title"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="grievance_count"/>
                        </group>
                        <group string="بيانات التظلم">
                            <field name="company_id"/>
                            <field name="value" readonly="decision == 'accepted'"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="التظلم">
                            <group string="وصف التظلم">
                                <field name="description"/>
                                <field name="notes"/>
                            </group>
                            <group string="رد القسم المشكو منه">
                                <field name="complained_department_id"/>
                                <field name="department_reply"/>
                                <field name="reply"/>
                            </group>
                        </page>
                        <page string="القرار">
                            <group>
                                <group>
                                    <field name="decision" readonly="1"/>
                                    <field name="financial_state"/>
                                    <field name="hold_state"/>
                                </group>
                                <group>
                                    <field name="executor_ids" widget="many2many_tags"/>
                                    <field name="signature" widget="signature"/>
                                </group>
                            </group>
                        </page>
                        <page string="أسطر جديدة">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="الدفعات">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_grievance_search" model="ir.ui.view">
        <field name="name">hr.grievance.search</field>
        <field name="model">hr.grievance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="complained_department_id"/>
                <filter name="f_request" string="طلب" domain="[('state','=','request')]"/>
                <filter name="f_in_progress" string="قيد التنفيذ" domain="[('state','=','in_progress')]"/>
                <filter name="f_rejected" string="مرفوض" domain="[('state','=','rejected')]"/>
                <filter name="f_done" string="منتهي" domain="[('state','=','done')]"/>
                <filter name="f_archived" string="مؤرشف" domain="[('active','=',False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="g_state" string="الحالة" context="{'group_by':'state'}"/>
                    <filter name="g_decision" string="القرار" context="{'group_by':'decision'}"/>
                    <filter name="g_employee" string="الموظف" context="{'group_by':'employee_id'}"/>
                    <filter name="g_dept" string="القسم" context="{'group_by':'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_grievance" model="ir.actions.act_window">
        <field name="name">تظلمات</field>
        <field name="res_model">hr.grievance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_grievance"
              name="تظلمات"
              parent="menu_hr_incentives_root"
              action="action_hr_grievance"
              sequence="40"/>
</odoo>
