<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- دفعات المكافآت والالتماسات والتظلمات -->
    <record id="action_incentive_payments" model="ir.actions.act_window">
        <field name="name">الدفعات</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', '|', ('reward_id', '!=', False), ('petition_id', '!=', False), ('grievance_id', '!=', False)]</field>
    </record>

    <menuitem id="menu_incentive_payments"
              name="الدفعات"
              parent="menu_configuration_category"
              action="action_incentive_payments"
              groups="account.group_account_invoice"
              sequence="40"/>
</odoo>
