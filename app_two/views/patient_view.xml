<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_admit" type="object" string="Admit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_treatment" type="object" string="Start Treatment" class="btn-primary" invisible="state != 'admitted'"/>
                    <button name="action_discharge" type="object" string="Discharge" class="btn-primary" invisible="state != 'under_treatment'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,admitted,under_treatment,discharged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Patient Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="national_id"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="date"/>
                        </group>
                        <group string="Medical Information">
                            <field name="doctor_id"/>
                            <field name="Blood_type"/>
                            <field name="room_num"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="اكتب أي ملاحظات عن حالة المريض..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="national_id"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="doctor_id"/>
                <field name="Blood_type" widget="badge"
                       decoration-danger="Blood_type in ['o-', 'ab-']"
                       decoration-info="Blood_type not in ['o-', 'ab-']"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name"/>
                <field name="national_id"/>
                <field name="doctor_id"/>

                <filter string="Under Treatment" name="filter_under_treatment" domain="[('state', '=', 'under_treatment')]"/>
                <filter string="Discharged" name="filter_discharged" domain="[('state', '=', 'discharged')]"/>
                <filter string="Rare Blood Type" name="filter_rare_blood" domain="[('Blood_type', 'in', ['o-', 'ab-'])]"/>

                <group expand="0" string="Group By">
                    <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Blood Type" name="group_blood_type" context="{'group_by': 'Blood_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_search"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hospital_root" name="Hospital" sequence="10" web_icon="app_two,static/description/icon.png"/>
    <menuitem id="menu_hospital_patient" name="Patients" parent="menu_hospital_root" action="action_hospital_patient" sequence="10"/>
</odoo>
