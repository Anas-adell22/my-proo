<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hospital_invoice_form" model="ir.ui.view">
        <field name="name">hospital.invoice.form</field>
        <field name="model">hospital.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <sheet>
                    <group>
                        <group string="Patient Information">
                            <field name="patient_id"/>
                            <field name="patient_name"/>
                            <field name="patient_phone"/>
                            <field name="patient_national_id"/>
                        </group>
                        <group string="Stay Details">
                            <field name="admission_date"/>
                            <field name="discharge_date"/>
                            <field name="number_of_days" readonly="1"/>
                            <field name="room_price_per_day"/>
                            <field name="room_total_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hospital_invoice_list" model="ir.ui.view">
        <field name="name">hospital.invoice.list</field>
        <field name="model">hospital.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="patient_id"/>
                <field name="admission_date"/>
                <field name="discharge_date"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">hospital.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hospital_invoice" name="Invoices" parent="menu_hospital_root" action="action_hospital_invoice" sequence="30"/>
</odoo>